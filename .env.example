# PostgreSQL — Minha Quadra (Multi-tenant) — compatível Neon / Supabase / Local
#
# >>> PARA APLICAR NO VERCEL: copie os VALORES abaixo (sem #) nas Environment Variables do projeto
#
# Exemplo Neon (obrigatório REMOVER &channel_binding=require se for usar em directUrl / migrate):
DATABASE_URL="postgresql://user:password@p54321.us-east-1.pooler.supabase.com:6543/db?sslmode=require"
# Gere um segredo aleatório exclusivo para cada ambiente (mínimo 32 caracteres).
AUTH_SECRET=
# Optional seed-only password; required if you run `npm run seed` (minimum 12 characters).
SEED_ADMIN_PASSWORD=

# Mercado Pago Billing (use as credenciais de teste durante a integração)
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe Billing (configuração legada; mantenha enquanto houver assinaturas Stripe ativas)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ESSENCIAL_MONTHLY=price_...
STRIPE_PRICE_PROFISSIONAL_MONTHLY=price_...
STRIPE_PRICE_EMPRESA_MONTHLY=price_...
#
# (Opcional) Neon — conexão DIRETA para migrations (sem -pooler no host). Também SEM channel_binding=require
# DIRECT_URL="postgresql://user:password@ep-xxx-12345.us-east-1.aws.neon.tech/db?sslmode=require"

